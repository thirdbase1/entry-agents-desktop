{
  "name": "entry-agents-desktop",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Entry Desktop — Native Rust AI Coding Agent & Local Sidecar Runtime",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:sidecar:win": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile dist/entry-agent-sidecar.exe"
  },
  "dependencies": {
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22"
  }
}
